<Window x:Class="ChineseBuddy.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500" MinWidth="380" MaxHeight="700" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="#F0F4F8" Foreground="#333333" FontFamily="Microsoft YaHei" Icon="/ChineseBuddy;component/Chinese.ico">
    <Window.Resources>
        <SolidColorBrush x:Key="DialogPrimary" Color="#409EFF"/>
        <SolidColorBrush x:Key="DialogPrimaryHover" Color="#66B1FF"/>
        <SolidColorBrush x:Key="DialogBorder" Color="#D0D7DE"/>
        <SolidColorBrush x:Key="DialogHeader" Color="#EBF5FF"/>
        <Style x:Key="DialogPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource DialogPrimary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinWidth" Value="82"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource DialogPrimaryHover}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#3A8EE6"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#1B5FA5"/><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="1"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DialogSecondaryButton" TargetType="Button" BasedOn="{StaticResource DialogPrimaryButton}">
            <Setter Property="Background" Value="#F1F7FE"/>
            <Setter Property="Foreground" Value="#368BE5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="#C8DFF6" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#E5F2FF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#D7EBFF"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#1B5FA5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/><Setter Property="BorderBrush" Value="{StaticResource DialogBorder}"/>
            <Setter Property="FontSize" Value="13"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="8,6"/><Setter Property="BorderBrush" Value="{StaticResource DialogBorder}"/>
            <Setter Property="FontSize" Value="13"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="#4B5563"/>
        </Style>
    </Window.Resources>
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource DialogBorder}" BorderThickness="0,0,0,1" Padding="16,11">
            <StackPanel Orientation="Horizontal">
                <Border Width="32" Height="32" Background="{StaticResource DialogHeader}" CornerRadius="5" Margin="0,0,10,0">
                    <TextBlock Text="汉" Foreground="{StaticResource DialogPrimary}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="HeadingText" FontSize="15" FontWeight="SemiBold" Foreground="#36B5A0"/>
                    <TextBlock Text="汉字小伙伴" FontSize="11" Foreground="#6B7280" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource DialogBorder}" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel x:Name="FooterButtons" Orientation="Horizontal" HorizontalAlignment="Right"/>
        </Border>
        <Border Background="White" BorderBrush="{StaticResource DialogBorder}" BorderThickness="1" CornerRadius="6" Margin="12" Padding="16">
            <ContentPresenter x:Name="BodyHost"/>
        </Border>
    </DockPanel>
</Window>
