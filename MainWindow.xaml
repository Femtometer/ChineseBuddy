<Window x:Class="ChineseBuddy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="汉字小伙伴 V1.00" Height="768" Width="1024"
        WindowStartupLocation="CenterScreen" Background="#F0F4F8" FontFamily="Microsoft YaHei" Foreground="#333333" Icon="/Chinese.ico" ResizeMode="CanMinimize">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#409EFF"/>
        <SolidColorBrush x:Key="PrimaryHover" Color="#66B1FF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#36B5A0"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#D0D7DE"/>
        <SolidColorBrush x:Key="HeaderBg" Color="#EBF5FF"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#6B7280"/>

        <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource PrimaryHover}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#3A8EE6"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#1B5FA5"/><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="1"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#F1F7FE"/>
            <Setter Property="Foreground" Value="#368BE5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="#C8DFF6" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#E5F2FF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#D7EBFF"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#1B5FA5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,5"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="8,6"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="#4B5563"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <primitives:TabPanel Grid.Row="0" IsItemsHost="True" Margin="1,0,0,0"/>
                            <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="0,6,6,6">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#657487"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="17,10"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#EBF5FF"/><Setter Property="Foreground" Value="#368BE5"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="White"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="#409EFF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="Margin" Value="0,14,0,0"/><Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="42"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E8EDF3"/><Setter Property="BorderBrush" Value="#E0E7EF"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F8FBFF"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F3F8FE"/><Setter Property="Foreground" Value="#58718C"/>
            <Setter Property="Padding" Value="10,9"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#E0E7EF"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="CenteredGridText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="CenteredGridCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CenteredGridCheckBoxDisplay" TargetType="CheckBox" BasedOn="{StaticResource CenteredGridCheckBox}">
            <Setter Property="IsHitTestVisible" Value="False"/><Setter Property="Focusable" Value="False"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,0"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="12"/>
            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DCEEFF"/><Setter Property="Foreground" Value="#1F4F7B"/></Trigger></Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Ellipse Width="9" Height="9" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="准备就绪" Margin="9,0,12,0" FontSize="12" Foreground="#4B5563" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <Button Grid.Column="2" Content="取消当前任务" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" Margin="0" Padding="10,5"/>
            </Grid>
        </Border>

        <TabControl x:Name="Tabs" Margin="14,13,14,14">
            <TabItem Header="生字管理">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="0,6,0,0" Padding="16,11">
                        <StackPanel><TextBlock Text="生字管理" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text="导入课本后核对识别结果；双击生字可编辑拼音、词语和掌握状态。" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
                    </Border>
                    <DockPanel Margin="16">
                        <StackPanel DockPanel.Dock="Top">
                        <WrapPanel>
                            <Button Content="导入课本 PDF" Click="Import_Click"/>
                            <Button Content="手动添加生字" Click="AddCharacter_Click" Style="{StaticResource SecondaryButton}"/>
                            <Button Content="编辑选中生字" Click="EditCharacter_Click" Style="{StaticResource SecondaryButton}"/>
                            <Button Content="查询字典" Click="CharacterDictionary_Click" Style="{StaticResource SecondaryButton}"/>
                            <Button Content="批量查询字典" Click="CharacterBatchDictionary_Click" Style="{StaticResource SecondaryButton}" ToolTip="批量查询全部生字，不受搜索和筛选条件限制。"/>
                            <Button Content="清空生字" Click="ClearCharacters_Click" Style="{StaticResource SecondaryButton}"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,10,0,0">
                            <TextBlock Text="搜索" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,7,0"/>
                            <TextBox x:Name="SearchBox" Width="130" TextChanged="Search_Changed"/>
                            <CheckBox x:Name="UnmasteredOnly" Content="仅未掌握" FontSize="12" Margin="14,0,0,0" Checked="Search_Changed" Unchecked="Search_Changed"/>
                            <CheckBox x:Name="WithoutWordsOnly" Content="搜索未找到词语" FontSize="12" Margin="14,0,0,0" Checked="Search_Changed" Unchecked="Search_Changed" ToolTip="仅显示没有词语的生字。"/>
                            <CheckBox x:Name="ReplaceCharacterWordsOnBatch" Content="批量查询时替换已有词语" FontSize="12" Margin="14,0,0,0" ToolTip="对全部生字，用成功取得的汉典词语替换已有词语。"/>
                        </WrapPanel>
                        </StackPanel>
                        <DataGrid x:Name="CharactersGrid" IsReadOnly="True" MouseDoubleClick="EditCharacter_Click" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn ElementStyle="{StaticResource CenteredGridText}" Header="汉字" Binding="{Binding Character}" Width="70"/>
                                <DataGridTextColumn ElementStyle="{StaticResource CenteredGridText}" Header="拼音" Binding="{Binding Pinyin}" Width="120"/>
                                <DataGridTextColumn ElementStyle="{StaticResource CenteredGridText}" Header="词语" Binding="{Binding WordsText}" Width="*"/>
                                <DataGridTextColumn ElementStyle="{StaticResource CenteredGridText}" Header="最近复习" Binding="{Binding LastReviewedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="160"/>
                                <DataGridTextColumn ElementStyle="{StaticResource CenteredGridText}" Header="复习次数" Binding="{Binding ReviewCount}" Width="90"/>
                                <DataGridTextColumn ElementStyle="{StaticResource CenteredGridText}" Header="错误次数" Binding="{Binding ErrorCount}" Width="90"/>
                                <DataGridCheckBoxColumn ElementStyle="{StaticResource CenteredGridCheckBoxDisplay}" EditingElementStyle="{StaticResource CenteredGridCheckBox}" Header="已掌握" Binding="{Binding IsMastered}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </DockPanel>
            </TabItem>

            <TabItem Header="生成练习纸">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="0,6,0,0" Padding="16,11">
                        <StackPanel><TextBlock Text="生成练习纸" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text="先抽取生字，再按需查询拼音和词语；勾选要换掉的字后可重新抽取。" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
                    </Border>
                    <DockPanel Margin="16">
                        <StackPanel DockPanel.Dock="Top">
                        <WrapPanel>
                            <Button Content="抽取生字" Click="Select_Click"/>
                            <Button Content="重新抽取勾选项" Click="Replace_Click" Style="{StaticResource SecondaryButton}"/>
                            <Button Content="编辑选中生字" Click="EditSelected_Click" Style="{StaticResource SecondaryButton}"/>
                            <Button Content="查询字典" Click="Dictionary_Click" Style="{StaticResource SecondaryButton}"/>
                            <Button Content="批量查询字典" Click="BatchDictionary_Click" Style="{StaticResource SecondaryButton}"/>
                            <Button Content="生成练习纸" Click="Generate_Click"/>
                        </WrapPanel>
                        <CheckBox x:Name="ReplaceWordsOnBatch" Content="批量查询时替换已有词语" FontSize="12" Margin="0,10,0,0" ToolTip="勾选后，仅对本次抽取的生字，用成功取得的汉典词语及拼音替换已有词语。"/>
                        </StackPanel>
                        <DataGrid x:Name="SelectionGrid">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn ElementStyle="{StaticResource CenteredGridCheckBoxDisplay}" EditingElementStyle="{StaticResource CenteredGridCheckBox}" Header="重新抽取" Binding="{Binding Replace, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                                <DataGridTextColumn ElementStyle="{StaticResource CenteredGridText}" Header="汉字" Binding="{Binding Item.Character}" IsReadOnly="True" Width="100"/>
                                <DataGridTextColumn ElementStyle="{StaticResource CenteredGridText}" Header="拼音" Binding="{Binding Item.Pinyin}" IsReadOnly="True" Width="120"/>
                                <DataGridTextColumn ElementStyle="{StaticResource CenteredGridText}" Header="词语" Binding="{Binding Item.WordsText}" IsReadOnly="True" Width="*"/>
                                <DataGridTextColumn ElementStyle="{StaticResource CenteredGridText}" Header="复习次数" Binding="{Binding Item.ReviewCount}" IsReadOnly="True" Width="100"/>
                                <DataGridTextColumn ElementStyle="{StaticResource CenteredGridText}" Header="错误次数" Binding="{Binding Item.ErrorCount}" IsReadOnly="True" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </DockPanel>
            </TabItem>

            <TabItem Header="批改练习纸">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="0,6,0,0" Padding="16,11">
                        <StackPanel><TextBlock Text="批改练习纸" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text="导入扫描件后逐题检查；正确列的灰色方框表示待确认，点击可切换正确或错误。" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
                    </Border>
                    <DockPanel Margin="16">
                        <WrapPanel DockPanel.Dock="Top">
                            <Button Content="导入扫描件并识别" Click="Scan_Click"/>
                            <Button Content="保存批改结果" Click="SaveReview_Click"/>
                            <TextBlock x:Name="WorksheetText" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="6,0,0,0"/>
                        </WrapPanel>
                        <DataGrid x:Name="ReviewGrid" RowHeight="80">
                            <DataGrid.Columns>
                                <DataGridTextColumn ElementStyle="{StaticResource CenteredGridText}" Header="题号" Binding="{Binding Question.Number}" IsReadOnly="True" Width="60"/>
                                <DataGridTextColumn ElementStyle="{StaticResource CenteredGridText}" Header="答案" Binding="{Binding Question.Character}" IsReadOnly="True" Width="70"/>
                                <DataGridTemplateColumn Header="手写内容" Width="100">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><Image Source="{Binding Image}" Width="70" Height="70"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn ElementStyle="{StaticResource CenteredGridText}" Header="识别结果" Binding="{Binding Recognized}" IsReadOnly="True" Width="*"/>
                                <DataGridCheckBoxColumn ElementStyle="{StaticResource CenteredGridCheckBoxDisplay}" EditingElementStyle="{StaticResource CenteredGridCheckBox}" Header="正确（灰色待确认）" Binding="{Binding IsCorrect, UpdateSourceTrigger=PropertyChanged}" IsThreeState="True" Width="150"/>
                                <DataGridCheckBoxColumn ElementStyle="{StaticResource CenteredGridCheckBoxDisplay}" EditingElementStyle="{StaticResource CenteredGridCheckBox}" Header="已掌握" Binding="{Binding IsMastered, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                                <DataGridTextColumn ElementStyle="{StaticResource CenteredGridText}" Header="复习次数" Binding="{Binding ReviewCount}" IsReadOnly="True" Width="90"/>
                                <DataGridTextColumn ElementStyle="{StaticResource CenteredGridText}" Header="错误次数" Binding="{Binding ErrorCount}" IsReadOnly="True" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </DockPanel>
            </TabItem>

            <TabItem Header="设置">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="0,6,0,0" Padding="16,11">
                        <StackPanel><TextBlock Text="设置" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text="配置在线识别和词语黑名单。" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20" MaxWidth="700" HorizontalAlignment="Left">
                            <Border Background="#F8FBFF" BorderBrush="#E0E7EF" BorderThickness="1" CornerRadius="5" Padding="14" Margin="0,0,0,20">
                                <TextBlock Text="课本 PDF 和手写答题图片会上传至 PaddleOCR 服务进行识别。程序优先使用环境变量 PaddleOCR_TOKEN；未设置时使用下方保存的令牌。" TextWrapping="Wrap" Foreground="#52657A" FontSize="12" LineHeight="21"/>
                            </Border>
                            <TextBlock Text="备用访问令牌" FontWeight="SemiBold" FontSize="13"/>
                            <PasswordBox x:Name="TokenBox" Width="500" MaxWidth="650" HorizontalAlignment="Left" Margin="0,8,0,12"/>
                            <WrapPanel><Button Content="保存备用令牌" Click="SaveToken_Click"/><Button Content="清除备用令牌" Click="ClearToken_Click" Style="{StaticResource SecondaryButton}"/></WrapPanel>
                            <TextBlock Text="备用令牌使用当前 Windows 用户加密保存，不写入生字数据库。" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,14,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="词语黑名单" FontWeight="SemiBold" FontSize="13" Margin="0,24,0,0"/>
                            <TextBlock Text="每行一个完整词语；查询字典时按词语精确排除，不自动修改已保存的生字。" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <TextBox x:Name="BlacklistBox" Width="500" Height="160" HorizontalAlignment="Left" Margin="0,8,0,12" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                            <WrapPanel><Button Content="保存黑名单" Click="SaveBlacklist_Click"/></WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
