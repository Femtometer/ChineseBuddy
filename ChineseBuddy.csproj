<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Chinese.ico</ApplicationIcon>
	<PublishSingleFile>true</PublishSingleFile>
	<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <Resource Include="Chinese.ico" />
    <EmbeddedResource Include="data\现代汉语常用字表.txt" LogicalName="ChineseBuddy.CommonCharacters.txt" />
    <EmbeddedResource Include="data\语文教材文本\**\*.md" LogicalName="ChineseBuddy.Textbooks.%(RecursiveDir)%(Filename)%(Extension)" />
    <PackageReference Include="PdfSharp" Version="6.2.4" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.13.0.20261107" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
  </ItemGroup>

</Project>
